node_modules/
# Local inspection output from `npm run docs:build` / `node
# scripts/build-docs.js`. Not committed — the published site is the
# generated HTML that scripts/publish-docs.js syncs into docs/ for the
# GitHub Pages branch deploy.
docs-dist/
npm-debug.log*
mouaif.out
mouaif.err
.env
*.pem
.DS_Store
Thumbs.db
*.local/

# Per-project mouaif data. These files are user state for the mouaif app
# itself (chat list, message transcripts, trace streams) and should
# never be committed by the mouaif project — they're created at runtime
# by `mouaif serve` whenever a user registers a project under the mouaif
# source tree. If the user is intentionally versioning their chat
# history inside the mouaif repo, they can `git add -f` the file.
.mouaif.json
.mouaif.messages.*.json
.mouaif/
# Raw V8 heap snapshots and the run manifest written by the performance
# profiler (scripts/perf-profile.mjs). A snapshot of a real chat is 40-200 MB of
# JSON, so only the report itself (perf/latest.json) is committed; the
# snapshots stay on the machine that recorded them.
perf/snapshots/
perf/*.manifest.json
# Every default run is also archived here for scripts/perf-compare.mjs. Runs are
# per-machine history; the committed perf/latest.json is the shared baseline.
perf/runs/

# Transient staging files from the atomic project-file writes (see
# src/settings.js writeJsonFile). They exist only between the write and the
# rename; a crash can leave one behind.
.mouaif*.tmp-*

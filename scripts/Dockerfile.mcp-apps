# Isolated regression image; never restarts or mounts the running host app.
FROM mouaif-app:latest
USER root
WORKDIR /track
COPY . .
# Low priority and a bounded heap, as in the main Dockerfile's build stage, so
# the install cannot push a small host into swap. Cap the test run itself with
# `docker run --cpus=1 --memory=768m --memory-swap=768m ...`.
RUN NODE_OPTIONS=--max-old-space-size=1024 nice -n 10 npm ci --include=dev --no-audit --no-fund
ENV MOUAIF_HOME=/tmp/mouaif-apps-tests
CMD ["sh", "-c", "node scripts/test-mcp-apps-detection.js && node scripts/test-mcp-apps-host.js && node scripts/test-mcp-apps-ui.mjs && node scripts/test-mcp-apps-e2e.mjs && node scripts/test-mcp.js && node scripts/test-web-csp.js"]
